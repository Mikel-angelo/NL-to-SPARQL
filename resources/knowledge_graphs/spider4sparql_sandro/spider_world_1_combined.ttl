@prefix : <http://valuenet/ontop/> .
@prefix ns1: <http://valuenet/ontop/city#> .
@prefix ns2: <http://valuenet/ontop/country#> .
@prefix ns3: <http://valuenet/ontop/countrylanguage#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

: a owl:Ontology .

ns1:countrycode a owl:DatatypeProperty ;
    rdfs:domain :city ;
    rdfs:range xsd:string .

ns1:district a owl:DatatypeProperty ;
    rdfs:domain :city ;
    rdfs:range xsd:string .

ns1:id a owl:DatatypeProperty ;
    rdfs:domain :city ;
    rdfs:range xsd:integer .

ns1:name a owl:DatatypeProperty ;
    rdfs:domain :city ;
    rdfs:range xsd:string .

ns1:population a owl:DatatypeProperty ;
    rdfs:domain :city ;
    rdfs:range xsd:integer .

ns1:ref-countrycode a owl:ObjectProperty ;
    rdfs:domain :city ;
    rdfs:range :country .

