    ns1:is_full_time true ;
    ns1:ref-employee_id <http://valuenet/ontop/employee/employee_id=5> ;
    ns1:ref-shop_id <http://valuenet/ontop/shop/shop_id=5> ;
    ns1:shop_id 5 ;
    ns1:start_from "2013" .

<http://valuenet/ontop/hiring/employee_id=6> a :hiring ;
