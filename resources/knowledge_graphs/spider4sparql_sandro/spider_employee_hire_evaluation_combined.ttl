@prefix : <http://valuenet/ontop/> .
@prefix ns1: <http://valuenet/ontop/hiring#> .
@prefix ns2: <http://valuenet/ontop/shop#> .
@prefix ns3: <http://valuenet/ontop/employee#> .
@prefix ns4: <http://valuenet/ontop/evaluation#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

: a owl:Ontology .

ns3:age a owl:DatatypeProperty ;
    rdfs:domain :employee ;
    rdfs:range xsd:integer .

ns3:city a owl:DatatypeProperty ;
    rdfs:domain :employee ;
    rdfs:range xsd:string .

ns3:employee_id a owl:DatatypeProperty ;
    rdfs:domain :employee ;
    rdfs:range xsd:integer .

ns3:name a owl:DatatypeProperty ;
    rdfs:domain :employee ;
    rdfs:range xsd:string .

<http://valuenet/ontop/employee/employee_id=8> a :employee ;
    ns3:age 40 ;
    ns3:city "Wasps" ;
    ns3:employee_id 8 ;
    ns3:name "Phil Vickery" .

<http://valuenet/ontop/employee/employee_id=9> a :employee ;
    ns3:age 32 ;
    ns3:city "Bath" ;
    ns3:employee_id 9 ;
    ns3:name "Steve Borthwick" .

ns4:bonus a owl:DatatypeProperty ;
    rdfs:domain :evaluation ;
    rdfs:range xsd:double .

ns4:employee_id a owl:DatatypeProperty ;
    rdfs:domain :evaluation ;
    rdfs:range xsd:integer .

ns4:ref-employee_id a owl:ObjectProperty ;
    rdfs:domain :evaluation ;
    rdfs:range :employee .

ns4:year_awarded a owl:DatatypeProperty ;
    rdfs:domain :evaluation ;
    rdfs:range xsd:string .

<http://valuenet/ontop/evaluation/employee_id=10;year_awarded=2016> a :evaluation ;
    ns4:bonus 4e+03 ;
    ns4:employee_id 10 ;
    ns4:ref-employee_id <http://valuenet/ontop/employee/employee_id=10> ;
    ns4:year_awarded "2016" .

<http://valuenet/ontop/evaluation/employee_id=1;year_awarded=2011> a :evaluation ;
    ns4:bonus 3e+03 ;
    ns4:employee_id 1 ;
    ns4:ref-employee_id <http://valuenet/ontop/employee/employee_id=1> ;
    ns4:year_awarded "2011" .

<http://valuenet/ontop/evaluation/employee_id=1;year_awarded=2016> a :evaluation ;
    ns4:bonus 2.9e+03 ;
    ns4:employee_id 1 ;
    ns4:ref-employee_id <http://valuenet/ontop/employee/employee_id=1> ;
    ns4:year_awarded "2016" .

<http://valuenet/ontop/evaluation/employee_id=2;year_awarded=2015> a :evaluation ;
    ns4:bonus 3.2e+03 ;
    ns4:employee_id 2 ;
    ns4:ref-employee_id <http://valuenet/ontop/employee/employee_id=2> ;
    ns4:year_awarded "2015" .

<http://valuenet/ontop/evaluation/employee_id=4;year_awarded=2017> a :evaluation ;
    ns4:bonus 3.2e+03 ;
    ns4:employee_id 4 ;
    ns4:ref-employee_id <http://valuenet/ontop/employee/employee_id=4> ;
    ns4:year_awarded "2017" .

<http://valuenet/ontop/evaluation/employee_id=7;year_awarded=2018> a :evaluation ;
    ns4:bonus 3.2e+03 ;
    ns4:employee_id 7 ;
    ns4:ref-employee_id <http://valuenet/ontop/employee/employee_id=7> ;
    ns4:year_awarded "2018" .

ns1:employee_id a owl:DatatypeProperty ;
    rdfs:domain :hiring ;
    rdfs:range xsd:integer .

ns1:is_full_time a owl:DatatypeProperty ;
    rdfs:domain :hiring ;
    rdfs:range xsd:boolean .

ns1:ref-employee_id a owl:ObjectProperty ;
    rdfs:domain :hiring ;
    rdfs:range :employee .

ns1:ref-shop_id a owl:ObjectProperty ;
    rdfs:domain :hiring ;
    rdfs:range :shop .

ns1:shop_id a owl:DatatypeProperty ;
    rdfs:domain :hiring ;
    rdfs:range xsd:integer .

ns1:start_from a owl:DatatypeProperty ;
    rdfs:domain :hiring ;
    rdfs:range xsd:string .

<http://valuenet/ontop/hiring/employee_id=1> a :hiring ;
    ns1:employee_id 1 ;
    ns1:is_full_time true ;
    ns1:ref-employee_id <http://valuenet/ontop/employee/employee_id=1> ;
    ns1:ref-shop_id <http://valuenet/ontop/shop/shop_id=1> ;
    ns1:shop_id 1 ;
    ns1:start_from "2009" .

<http://valuenet/ontop/hiring/employee_id=2> a :hiring ;
    ns1:employee_id 2 ;
    ns1:is_full_time true ;
    ns1:ref-employee_id <http://valuenet/ontop/employee/employee_id=2> ;
