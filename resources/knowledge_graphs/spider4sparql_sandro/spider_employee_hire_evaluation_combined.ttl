    ns1:is_full_time false ;
    ns1:ref-employee_id <http://valuenet/ontop/employee/employee_id=6> ;
    ns1:ref-shop_id <http://valuenet/ontop/shop/shop_id=2> ;
    ns1:shop_id 2 ;
    ns1:start_from "2010" .

<http://valuenet/ontop/hiring/employee_id=7> a :hiring ;
    ns1:employee_id 7 ;
    ns1:is_full_time true ;
    ns1:ref-employee_id <http://valuenet/ontop/employee/employee_id=7> ;
    ns1:ref-shop_id <http://valuenet/ontop/shop/shop_id=6> ;
    ns1:shop_id 6 ;
    ns1:start_from "2008" .

