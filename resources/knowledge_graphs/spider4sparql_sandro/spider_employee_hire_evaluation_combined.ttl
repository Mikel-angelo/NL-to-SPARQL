    ns1:ref-employee_id <http://valuenet/ontop/employee/employee_id=4> ;
    ns1:ref-shop_id <http://valuenet/ontop/shop/shop_id=4> ;
    ns1:shop_id 4 ;
    ns1:start_from "2012" .

<http://valuenet/ontop/hiring/employee_id=5> a :hiring ;
