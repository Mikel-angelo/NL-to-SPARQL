@prefix : <http://valuenet/ontop/> .
@prefix ns1: <http://valuenet/ontop/museum#> .
@prefix ns2: <http://valuenet/ontop/visit#> .
@prefix ns3: <http://valuenet/ontop/visitor#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

: a owl:Ontology .

ns1:museum_id a owl:DatatypeProperty ;
    rdfs:domain :museum ;
    rdfs:range xsd:integer .

ns1:name a owl:DatatypeProperty ;
    rdfs:domain :museum ;
    rdfs:range xsd:string .

ns1:num_of_staff a owl:DatatypeProperty ;
    rdfs:domain :museum ;
    rdfs:range xsd:integer .

ns1:open_year a owl:DatatypeProperty ;
    rdfs:domain :museum ;
    rdfs:range xsd:integer .

<http://valuenet/ontop/museum/museum_id=3> a :museum ;
    ns1:museum_id 3 ;
    ns1:name "Jefferson Development Museum" ;
    ns1:num_of_staff 18 ;
    ns1:open_year 2010 .

<http://valuenet/ontop/museum/museum_id=5> a :museum ;
    ns1:museum_id 5 ;
    ns1:name "RiverPark Museum" ;
    ns1:num_of_staff 16 ;
    ns1:open_year 2008 .

<http://valuenet/ontop/museum/museum_id=6> a :museum ;
    ns1:museum_id 6 ;
    ns1:name "Place Tower Museum" ;
    ns1:num_of_staff 16 ;
    ns1:open_year 2008 .

<http://valuenet/ontop/museum/museum_id=7> a :museum ;
    ns1:museum_id 7 ;
    ns1:name "Central City District Residential Museum" ;
    ns1:num_of_staff 15 ;
    ns1:open_year 2010 .

ns2:museum_id a owl:DatatypeProperty ;
    rdfs:domain :visit ;
    rdfs:range xsd:integer .

ns2:num_of_ticket a owl:DatatypeProperty ;
    rdfs:domain :visit ;
    rdfs:range xsd:integer .

ns2:ref-museum_id a owl:ObjectProperty ;
    rdfs:domain :visit ;
    rdfs:range :museum .

ns2:ref-visitor_id a owl:ObjectProperty ;
    rdfs:domain :visit ;
    rdfs:range :visitor .

ns2:total_spent a owl:DatatypeProperty ;
    rdfs:domain :visit ;
    rdfs:range xsd:double .

ns2:visitor_id a owl:DatatypeProperty ;
    rdfs:domain :visit ;
    rdfs:range xsd:integer .

<http://valuenet/ontop/visit/museum_id=1;visitor_id=5> a :visit ;
    ns2:museum_id 1 ;
    ns2:num_of_ticket 20 ;
    ns2:ref-museum_id <http://valuenet/ontop/museum/museum_id=1> ;
    ns2:ref-visitor_id <http://valuenet/ontop/visitor/id=5> ;
    ns2:total_spent 3.2014e+02 ;
    ns2:visitor_id 5 .

<http://valuenet/ontop/visit/museum_id=2;visitor_id=3> a :visit ;
    ns2:museum_id 2 ;
    ns2:num_of_ticket 24 ;
    ns2:ref-museum_id <http://valuenet/ontop/museum/museum_id=2> ;
    ns2:ref-visitor_id <http://valuenet/ontop/visitor/id=3> ;
    ns2:total_spent 2.0998e+02 ;
    ns2:visitor_id 3 .

<http://valuenet/ontop/visit/museum_id=2;visitor_id=5> a :visit ;
    ns2:museum_id 2 ;
    ns2:num_of_ticket 4 ;
    ns2:ref-museum_id <http://valuenet/ontop/museum/museum_id=2> ;
    ns2:ref-visitor_id <http://valuenet/ontop/visitor/id=5> ;
    ns2:total_spent 8.998e+01 ;
    ns2:visitor_id 5 .

<http://valuenet/ontop/visit/museum_id=4;visitor_id=3> a :visit ;
    ns2:museum_id 4 ;
    ns2:num_of_ticket 10 ;
    ns2:ref-museum_id <http://valuenet/ontop/museum/museum_id=4> ;
    ns2:ref-visitor_id <http://valuenet/ontop/visitor/id=3> ;
    ns2:total_spent 3.2044e+02 ;
    ns2:visitor_id 3 .

<http://valuenet/ontop/visit/museum_id=4;visitor_id=6> a :visit ;
    ns2:museum_id 4 ;
    ns2:num_of_ticket 3 ;
    ns2:ref-museum_id <http://valuenet/ontop/museum/museum_id=4> ;
    ns2:ref-visitor_id <http://valuenet/ontop/visitor/id=6> ;
    ns2:total_spent 2.044e+01 ;
    ns2:visitor_id 6 .

<http://valuenet/ontop/visit/museum_id=8;visitor_id=6> a :visit ;
    ns2:museum_id 8 ;
    ns2:num_of_ticket 2 ;
    ns2:ref-museum_id <http://valuenet/ontop/museum/museum_id=8> ;
    ns2:ref-visitor_id <http://valuenet/ontop/visitor/id=6> ;
    ns2:total_spent 1.998e+01 ;
    ns2:visitor_id 6 .

ns3:age a owl:DatatypeProperty ;
    rdfs:domain :visitor ;
    rdfs:range xsd:integer .

ns3:id a owl:DatatypeProperty ;
    rdfs:domain :visitor ;
    rdfs:range xsd:integer .

ns3:level_of_membership a owl:DatatypeProperty ;
    rdfs:domain :visitor ;
    rdfs:range xsd:integer .

ns3:name a owl:DatatypeProperty ;
    rdfs:domain :visitor ;
    rdfs:range xsd:string .

