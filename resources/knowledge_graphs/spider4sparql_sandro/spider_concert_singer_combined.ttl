ns4:year a owl:DatatypeProperty ;
    rdfs:domain :concert ;
    rdfs:range xsd:string .

ns2:age a owl:DatatypeProperty ;
    rdfs:domain :singer ;
    rdfs:range xsd:integer .

ns2:country a owl:DatatypeProperty ;
    rdfs:domain :singer ;
    rdfs:range xsd:string .

ns2:is_male a owl:DatatypeProperty ;
    rdfs:domain :singer ;
    rdfs:range xsd:boolean .

ns2:name a owl:DatatypeProperty ;
    rdfs:domain :singer ;
    rdfs:range xsd:string .

ns2:singer_id a owl:DatatypeProperty ;
    rdfs:domain :singer ;
    rdfs:range xsd:integer .

ns2:song_name a owl:DatatypeProperty ;
    rdfs:domain :singer ;
    rdfs:range xsd:string .

ns2:song_release_year a owl:DatatypeProperty ;
    rdfs:domain :singer ;
    rdfs:range xsd:string .

