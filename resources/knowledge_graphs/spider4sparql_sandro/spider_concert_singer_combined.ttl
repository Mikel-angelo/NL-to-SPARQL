@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

: a owl:Ontology .

ns4:concert_id a owl:DatatypeProperty ;
    rdfs:domain :concert ;
    rdfs:range xsd:integer .

ns4:concert_name a owl:DatatypeProperty ;
    rdfs:domain :concert ;
    rdfs:range xsd:string .

ns4:ref-stadium_id a owl:ObjectProperty ;
    rdfs:domain :concert ;
    rdfs:range :stadium .

ns4:stadium_id a owl:DatatypeProperty ;
    rdfs:domain :concert ;
    rdfs:range xsd:integer .

ns4:theme a owl:DatatypeProperty ;
    rdfs:domain :concert ;
