@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

: a owl:Ontology .

ns4:country a owl:DatatypeProperty ;
    rdfs:domain :car_makers ;
    rdfs:range xsd:integer .

ns4:fullname a owl:DatatypeProperty ;
    rdfs:domain :car_makers ;
    rdfs:range xsd:string .

ns4:id a owl:DatatypeProperty ;
    rdfs:domain :car_makers ;
    rdfs:range xsd:integer .

ns4:maker a owl:DatatypeProperty ;
    rdfs:domain :car_makers ;
    rdfs:range xsd:string .

ns4:ref-country a owl:ObjectProperty ;
    rdfs:domain :car_makers ;
    rdfs:range :countries .

ns1:make a owl:DatatypeProperty ;
    rdfs:domain :car_names ;
    rdfs:range xsd:string .

ns1:makeid a owl:DatatypeProperty ;
    rdfs:domain :car_names ;
    rdfs:range xsd:integer .

ns1:model a owl:DatatypeProperty ;
    rdfs:domain :car_names ;
    rdfs:range xsd:string .

ns1:ref-model a owl:ObjectProperty ;
    rdfs:domain :car_names ;
    rdfs:range :model_list .

ns2:accelerate a owl:DatatypeProperty ;
    rdfs:domain :cars_data ;
    rdfs:range xsd:double .

ns2:cylinders a owl:DatatypeProperty ;
    rdfs:domain :cars_data ;
    rdfs:range xsd:integer .

ns2:edispl a owl:DatatypeProperty ;
    rdfs:domain :cars_data ;
    rdfs:range xsd:double .

ns2:horsepower a owl:DatatypeProperty ;
    rdfs:domain :cars_data ;
    rdfs:range xsd:string .

ns2:id a owl:DatatypeProperty ;
    rdfs:domain :cars_data ;
    rdfs:range xsd:integer .

ns2:mpg a owl:DatatypeProperty ;
    rdfs:domain :cars_data ;
    rdfs:range xsd:double .

ns2:ref-id a owl:ObjectProperty ;
    rdfs:domain :cars_data ;
    rdfs:range :car_names .

ns2:weight a owl:DatatypeProperty ;
    rdfs:domain :cars_data ;
    rdfs:range xsd:integer .

ns2:year a owl:DatatypeProperty ;
    rdfs:domain :cars_data ;
    rdfs:range xsd:integer .

