@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

: a owl:Ontology .

ns1:bulgarian_commander a owl:DatatypeProperty ;
    rdfs:domain :battle ;
    rdfs:range xsd:string .

ns1:date a owl:DatatypeProperty ;
    rdfs:domain :battle ;
    rdfs:range xsd:string .

ns1:id a owl:DatatypeProperty ;
    rdfs:domain :battle ;
    rdfs:range xsd:integer .

ns1:latin_commander a owl:DatatypeProperty ;
    rdfs:domain :battle ;
    rdfs:range xsd:string .

ns1:name a owl:DatatypeProperty ;
    rdfs:domain :battle ;
    rdfs:range xsd:string .

ns1:result a owl:DatatypeProperty ;
    rdfs:domain :battle ;
    rdfs:range xsd:string .

<http://valuenet/ontop/battle/id=1> a :battle ;
