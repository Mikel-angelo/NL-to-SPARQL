    rdfs:range xsd:string .

ns3:ref-lost_in_battle a owl:ObjectProperty ;
    rdfs:domain :ship ;
    rdfs:range :battle .

ns3:ship_type a owl:DatatypeProperty ;
    rdfs:domain :ship ;
    rdfs:range xsd:string .

ns3:tonnage a owl:DatatypeProperty ;
    rdfs:domain :ship ;
    rdfs:range xsd:string .

