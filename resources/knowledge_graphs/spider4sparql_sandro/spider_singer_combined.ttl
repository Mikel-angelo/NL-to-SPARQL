@prefix : <http://valuenet/ontop/> .
@prefix ns1: <http://valuenet/ontop/song#> .
@prefix ns2: <http://valuenet/ontop/singer#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

: a owl:Ontology .

ns2:birth_year a owl:DatatypeProperty ;
    rdfs:domain :singer ;
    rdfs:range xsd:double .

ns2:citizenship a owl:DatatypeProperty ;
    rdfs:domain :singer ;
    rdfs:range xsd:string .

ns2:name a owl:DatatypeProperty ;
    rdfs:domain :singer ;
    rdfs:range xsd:string .

ns2:net_worth_millions a owl:DatatypeProperty ;
    rdfs:domain :singer ;
    rdfs:range xsd:double .

ns2:singer_id a owl:DatatypeProperty ;
    rdfs:domain :singer ;
    rdfs:range xsd:integer .

<http://valuenet/ontop/singer/singer_id=3> a :singer ;
    ns2:birth_year 1.949e+03 ;
    ns2:citizenship "United States" ;
    ns2:name "Alice Walton" ;
    ns2:net_worth_millions 2.63e+01 ;
    ns2:singer_id 3 .

