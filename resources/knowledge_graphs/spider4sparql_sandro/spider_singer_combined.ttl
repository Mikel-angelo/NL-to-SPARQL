ns1:highest_position a owl:DatatypeProperty ;
    rdfs:domain :song ;
    rdfs:range xsd:double .

ns1:ref-singer_id a owl:ObjectProperty ;
    rdfs:domain :song ;
    rdfs:range :singer .

ns1:sales a owl:DatatypeProperty ;
    rdfs:domain :song ;
    rdfs:range xsd:double .

ns1:singer_id a owl:DatatypeProperty ;
    rdfs:domain :song ;
    rdfs:range xsd:integer .

ns1:song_id a owl:DatatypeProperty ;
    rdfs:domain :song ;
    rdfs:range xsd:integer .

ns1:title a owl:DatatypeProperty ;
    rdfs:domain :song ;
    rdfs:range xsd:string .

<http://valuenet/ontop/song/song_id=1> a :song ;
    ns1:highest_position 1e+00 ;
    ns1:ref-singer_id <http://valuenet/ontop/singer/singer_id=1> ;
    ns1:sales 1.094e+06 ;
    ns1:singer_id 1 ;
    ns1:song_id 1 ;
    ns1:title "Do They Know It's Christmas" .

