@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

: a owl:Ontology .

ns2:petid a owl:DatatypeProperty ;
    rdfs:domain :has_pet ;
    rdfs:range xsd:integer .

ns2:ref-petid a owl:ObjectProperty ;
    rdfs:domain :has_pet ;
    rdfs:range :pets .

ns2:ref-stuid a owl:ObjectProperty ;
    rdfs:domain :has_pet ;
    rdfs:range :student .

ns2:stuid a owl:DatatypeProperty ;
    rdfs:domain :has_pet ;
    rdfs:range xsd:integer .

ns3:pet_age a owl:DatatypeProperty ;
    rdfs:domain :pets ;
    rdfs:range xsd:integer .

ns3:petid a owl:DatatypeProperty ;
    rdfs:domain :pets ;
    rdfs:range xsd:integer .

ns3:pettype a owl:DatatypeProperty ;
    rdfs:domain :pets ;
    rdfs:range xsd:string .

ns3:weight a owl:DatatypeProperty ;
    rdfs:domain :pets ;
    rdfs:range xsd:double .

ns1:advisor a owl:DatatypeProperty ;
    rdfs:domain :student ;
    rdfs:range xsd:integer .

ns1:age a owl:DatatypeProperty ;
    rdfs:domain :student ;
    rdfs:range xsd:integer .

ns1:city_code a owl:DatatypeProperty ;
    rdfs:domain :student ;
