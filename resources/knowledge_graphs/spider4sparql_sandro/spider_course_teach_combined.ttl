ns3:course_id a owl:DatatypeProperty ;
    rdfs:domain :course_arrange ;
    rdfs:range xsd:integer .

ns3:grade a owl:DatatypeProperty ;
    rdfs:domain :course_arrange ;
    rdfs:range xsd:integer .

ns3:ref-course_id a owl:ObjectProperty ;
    rdfs:domain :course_arrange ;
    rdfs:range :course .

ns3:ref-teacher_id a owl:ObjectProperty ;
    rdfs:domain :course_arrange ;
    rdfs:range :teacher .

ns3:teacher_id a owl:DatatypeProperty ;
    rdfs:domain :course_arrange ;
    rdfs:range xsd:integer .

<http://valuenet/ontop/course_arrange/course_id=10;teacher_id=7;grade=4> a :course_arrange ;
    ns3:course_id 10 ;
    ns3:grade 4 ;
    ns3:ref-course_id <http://valuenet/ontop/course/course_id=10> ;
    ns3:ref-teacher_id <http://valuenet/ontop/teacher/teacher_id=7> ;
    ns3:teacher_id 7 .

<http://valuenet/ontop/course_arrange/course_id=2;teacher_id=3;grade=3> a :course_arrange ;
