@prefix : <http://valuenet/ontop/> .
@prefix ns1: <http://valuenet/ontop/teacher#> .
@prefix ns2: <http://valuenet/ontop/course#> .
@prefix ns3: <http://valuenet/ontop/course_arrange#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

: a owl:Ontology .

ns2:course a owl:DatatypeProperty ;
    rdfs:domain :course ;
    rdfs:range xsd:string .

ns2:course_id a owl:DatatypeProperty ;
    rdfs:domain :course ;
    rdfs:range xsd:integer .

ns2:staring_date a owl:DatatypeProperty ;
    rdfs:domain :course ;
    rdfs:range xsd:string .

<http://valuenet/ontop/course/course_id=1> a :course ;
    ns2:course "Language Arts" ;
    ns2:course_id 1 ;
    ns2:staring_date "5 May" .

