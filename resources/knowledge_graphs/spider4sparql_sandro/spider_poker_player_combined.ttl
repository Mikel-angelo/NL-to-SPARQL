    ns1:birth_date "July 14, 1983" ;
    ns1:height 1.94e+02 ;
    ns1:name "Maksim Botin" ;
    ns1:nationality "Russia" ;
    ns1:people_id 6 .

<http://valuenet/ontop/people/people_id=7> a :people ;
