    ns2:final_table_made 1.9e+01 ;
    ns2:money_rank 5.8e+01 ;
    ns2:people_id 6 ;
    ns2:poker_player_id 4 ;
    ns2:ref-people_id <http://valuenet/ontop/people/people_id=6> .

<http://valuenet/ontop/poker_player/poker_player_id=5> a :poker_player ;
    ns2:best_finish 3e+00 ;
    ns2:earnings 1.428e+05 ;
    ns2:final_table_made 2.6e+01 ;
    ns2:money_rank 1.54e+02 ;
    ns2:people_id 7 ;
    ns2:poker_player_id 5 ;
    ns2:ref-people_id <http://valuenet/ontop/people/people_id=7> .

<http://valuenet/ontop/people/people_id=1> a :people ;
    ns1:birth_date "May 26, 1986" ;
    ns1:height 2.07e+02 ;
    ns1:name "Aleksey Ostapenko" ;
    ns1:nationality "Russia" ;
    ns1:people_id 1 .

