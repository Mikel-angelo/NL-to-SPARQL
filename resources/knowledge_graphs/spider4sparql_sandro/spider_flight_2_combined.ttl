@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

: a owl:Ontology .

ns3:abbreviation a owl:DatatypeProperty ;
    rdfs:domain :airlines ;
    rdfs:range xsd:string .

ns3:airline a owl:DatatypeProperty ;
    rdfs:domain :airlines ;
    rdfs:range xsd:string .

ns3:country a owl:DatatypeProperty ;
    rdfs:domain :airlines ;
    rdfs:range xsd:string .

ns3:uid a owl:DatatypeProperty ;
    rdfs:domain :airlines ;
    rdfs:range xsd:integer .

ns2:airportcode a owl:DatatypeProperty ;
    rdfs:domain :airports ;
    rdfs:range xsd:string .

ns2:airportname a owl:DatatypeProperty ;
    rdfs:domain :airports ;
    rdfs:range xsd:string .

ns2:city a owl:DatatypeProperty ;
    rdfs:domain :airports ;
    rdfs:range xsd:string .

ns2:country a owl:DatatypeProperty ;
    rdfs:domain :airports ;
    rdfs:range xsd:string .

ns2:countryabbrev a owl:DatatypeProperty ;
    rdfs:domain :airports ;
    rdfs:range xsd:string .

ns1:airline a owl:DatatypeProperty ;
    rdfs:domain :flights ;
    rdfs:range xsd:integer .

ns1:destairport a owl:DatatypeProperty ;
    rdfs:domain :flights ;
    rdfs:range xsd:string .

ns1:flightno a owl:DatatypeProperty ;
    rdfs:domain :flights ;
    rdfs:range xsd:integer .

ns1:join-airline a owl:ObjectProperty ;
    rdfs:domain :flights ;
    rdfs:range :airlines .

ns1:ref-destairport a owl:ObjectProperty ;
    rdfs:domain :flights ;
    rdfs:range :airports .

ns1:ref-sourceairport a owl:ObjectProperty ;
    rdfs:domain :flights ;
    rdfs:range :airports .

ns1:sourceairport a owl:DatatypeProperty ;
    rdfs:domain :flights ;
    rdfs:range xsd:string .

